# Default deny: only reviewed application files are publishable.
# New source files must be explicitly allowed below.
*

# Root application modules and setup
!/.gitignore
!/README.md
!/README.zh-CN.md
!/requirements.txt
!/Launch Caret.command
!/agent_files.py
!/gemini_stream.py
!/openai_writer.py
!/latex_project.py
!/synctex_mapping.py
!/pdf_text.py
!/remote_bridge.py
!/paper_assistant.py
!/paper_tools.py
!/paragraph_selection.py
!/projects.py
!/server.py
!/style_library.py
!/style_memory.py
!/writing_agent.py

# Browser application and bundled third-party runtime assets
!/ui/
!/ui/*.js
!/ui/*.css
!/ui/index.html
!/ui/vendor/
!/ui/vendor/*.js
!/ui/vendor/*.css
!/ui/vendor/*LICENSE.txt
!/ui/vendor/VERSIONS.txt
!/ui/vendor/fonts/
!/ui/vendor/fonts/KaTeX_*.woff
!/ui/vendor/fonts/KaTeX_*.woff2
!/ui/vendor/fonts/KaTeX_*.ttf

# Application role / skill definitions (not personal memories)
!/agents/
!/agents/README.md
!/agents/*/
!/agents/*/AGENT.md
!/skills/
!/skills/*/
!/skills/*/SKILL.md

# Tests with synthetic fixtures
!/tests/
!/tests/test_*.py
!/tests/check_remote_integration.py
!/tests/test_*.cjs
!/tests/package.json
!/tests/package-lock.json

# Explicit private/local exclusions; never force-add these.
.local/
workspaces/
style-library/
work/
.python/
.venv/
.tools/
node_modules/
__pycache__/
.DS_Store
.env
.env.*
*api-config*
*credentials*
*secret*
*.pem
*.key
*.p12
*.pfx
*.log
*.sqlite*
*.db
*.bak
*.tmp
/README.txt

# Shared English UI catalog and resource localizer
!/localization.py
!/overleaf_sync.py
!/ui/translations-en.json

# Draft brand artwork and web-sized derivatives
!/ui/assets/
!/ui/assets/draft-logo.png
!/ui/assets/draft-logo-128.png
!/ui/assets/draft-favicon-64.png

# Native macOS shell (generated .app stays local)
!/macos/
!/macos/Draft.swift
!/macos/serve.py
!/macos/build.py

!/macos/install_environment.py
!/macos/check_installation.py

!/preferences.py
!/AGENTS.md

!/macos/cleanup_releases.py

!/macos/caret.icns
!/ui/assets/caret/
!/ui/assets/caret/**

# Per-change development and release history
!/CHANGELOG.md

# Reviewed release artifacts
!/releases/
!/releases/v0.3.3/
!/releases/v0.3.3/Caret.dmg
!/releases/v0.3.3/SHA256SUMS
!/releases/v0.3.3/README.md

# Reviewed 0.3.4 release artifacts
!/releases/v0.3.4/
!/releases/v0.3.4/Caret.dmg
!/releases/v0.3.4/SHA256SUMS
!/releases/v0.3.4/README.md

# README screenshots
!/docs/
!/docs/screenshots/
!/docs/screenshots/latex-source.png
!/docs/screenshots/preferences.png
!/docs/screenshots/review-edit.png
!/docs/screenshots/writing-workspace.png
